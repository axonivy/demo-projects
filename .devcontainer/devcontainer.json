{
  "name": "Axon Ivy Demo",
  "dockerComposeFile": "compose.yaml",
  "service": "dev",
  "workspaceFolder": "/workspaces/project",
  "shutdownAction": "stopCompose",
  "remoteUser": "vscode",
  "updateRemoteUserUID": false,
  "forwardPorts": [8080],
  "postCreateCommand": "sudo chown vscode:vscode /home/vscode/.m2 /home/vscode/.m2/repository",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "25",
      "installMaven": "true",
      "jdkDistro": "tem"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["axonivy.vscode-designer-14", "vscjava.vscode-java-pack"],
      "settings": {
        "axonivy.engine.runByExtension": false,
        "axonivy.engine.url": "http://localhost:8080/",
        "java.jdt.ls.java.home": "/usr/local/sdkman/candidates/java/current"
      }
    }
  }
}
